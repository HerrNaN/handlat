amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"

// sqlc owns all Go files in these output directories, including their formatting.
local generatedGoFiles = List("backend/internal/app/*/db/*.go")

steps {
  // General
  ["check-added-large-files"] = Builtins.check_added_large_files
  ["check-case-conflict"] = Builtins.check_case_conflict
  ["check-executables-have-shebangs"] = Builtins.check_executables_have_shebangs
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["check-symlinks"] = Builtins.check_symlinks

  // Golang
  ["go-fumpt"] = (Builtins.go_fumpt) {
    exclude = generatedGoFiles
  }
  ["go-imports"] = (Builtins.go_imports) {
    exclude = generatedGoFiles
  }
  ["go-lines"] = (Builtins.go_lines) {
    exclude = generatedGoFiles
  }
  ["go-sec"] = (Builtins.go_sec) {
    // sqlc's generated query names trigger the hardcoded-credentials heuristic.
    check = "gosec -exclude-generated -quiet ./..."
  }
  ["go-vet"] = Builtins.go_vet
  ["go-golangci-lint"] = Builtins.golangci_lint
  ["go-mod-tidy"] = Builtins.gomod_tidy

  // Mise
  ["mise"] = Builtins.mise

  // Workflows and shell scripts
  ["actionlint"] = Builtins.actionlint
  ["shellcheck"] = Builtins.shellcheck

  // Web
  ["web-oxfmt"] = (Builtins.oxfmt) {
    dir = "frontend"
    prefix = List("pnpm", "exec")
    glob = Builtins.oxfmt.glob + List("**/*.svelte")
  }
  ["web-oxlint"] = Builtins.ox_lint
  ["web-eslint"] {
    dir = "frontend"
    glob = List("**/*.svelte", "**/*.svelte.js", "**/*.svelte.ts", "e2e/**/*.ts")
    check = "pnpm exec eslint {{files}}"
    fix = "pnpm exec eslint --fix {{files}}"
  }
  ["web-unit-tests"] {
    check = "pnpm test --run"
    dir = "frontend"
  }
  ["web-check"] {
    check = "pnpm check"
    dir = "frontend"
  }
}

hooks {
  // Linting and fixing are run explicitly.
  ["pre-commit"] {
    enabled = false
  }
  ["test"] {
    steps {
      ["go-tests"] {
        workspace_indicator = "go.mod"
        dir = "{{workspace}}"
        check = "go test -race ./..."
      }
      ["web-e2e-tests"] {
        check = "pnpm test:e2e"
        dir = "frontend"
      }
    }
  }
  ["audit"] {
    steps {
      ["go-vuln-check"] = Builtins.go_vuln_check
    }
  }
}
